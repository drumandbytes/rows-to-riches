{
  "name": "rows-to-riches",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test && node tools/music-audit.js",
    "db:migrate:local": "wrangler d1 migrations apply rows-to-riches --local",
    "db:migrate:remote": "wrangler d1 migrations apply rows-to-riches --remote",
    "deploy": "wrangler deploy",
    "test:browser": "BROWSER_SMOKE=1 node --test test/browser/*.test.js"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "wrangler": "^4.40.0"
  }
}
